{
  "Server": {
    "Urls": "http://127.0.0.1:8001"
  },
  "BattleStore": {
    "Provider": "mysql",
    "DatabasePath": "data/crimson-tide.db",
    "LockMode": "optimistic"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8000",
      "http://127.0.0.1:8000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
